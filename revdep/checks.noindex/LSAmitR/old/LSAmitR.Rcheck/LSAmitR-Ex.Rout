> ##D   points(x=log(a),y=dfr[ll,2:(L+1)],type="p",pch=15-ll)
> ##D   legend(x=2.8-0.7*(ll>tmp/2),y=25-2*(ifelse(ll>7,ll-7,ll)),
> ##D          legend =dfr$coef[ll],pch=15-ll,bty="n",cex=0.9)
> ##D }
> ##D 
