> ##D res1 <- BIFIE.linreg(BIFIEobj = dat,dep = "E8RPV", 
> ##D                      pre = c("one","female"))
> ##D                      
> ##D # Vollständige Ausgabe
> ##D summary(res1)
> ##D 
> ##D # Reduzierte Ausgabe der Ergebnisse
> ##D res1_short <- res1$stat[res1$stat$parameter == "b" &
