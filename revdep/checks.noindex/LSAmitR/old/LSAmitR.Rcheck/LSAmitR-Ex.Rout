> ##D # Abbildung 9.4
> ##D #
> ##D 
> ##D # Koeffizienten bei der ersten 50 lambdas ausdrucken
> ##D # Stratum 4
> ##D 
> ##D lambda <- lasso.mod2$lambda[1:50]
> ##D a <- round2(lambda,2)
> ##D a1 <- a[order(a)]
> ##D L <- length(a)
> ##D 
> ##D dfr <- NULL
> ##D 
> ##D for(ll in 1:L){
> ##D   dfr.ll <- as.matrix(coef(lasso.mod2,newx = Z,s=a[ll] ))
